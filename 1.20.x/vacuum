version = 20261013.0300
-- VACUUM SWEEPER v1.1
-- Snake sweeps L x W, sucks floor items, dumps into chests below.
-- Checks below for a chest on every cell; refuels from tagged fuel
-- or a lava bucket (slot 16) instead of digging forever at 0 fuel.
-- Uses full tracked path + reverse replay (from AE2 Scanner v3.1)
-- Returns to start & facing after each sweep. Runs until Q or Ctrl+T.

local LoopSetup = require("lib.LoopSetup")
local LoopFuel = require("lib.LoopFuel")
local cfg = LoopSetup.defaults()
local minFuel = 0

--------------------------------------
-- UTIL / UI
--------------------------------------
local function colorPrint(msg, color)
    term.setTextColor(color)
    print(msg)
    term.setTextColor(colors.white)
end

local function readNum(prompt)
    colorPrint(prompt, colors.orange)
    local n = tonumber(read())
    while not n or n <= 0 do
        colorPrint("Enter a valid positive number:", colors.red)
        n = tonumber(read())
    end
    return math.floor(n)
end

--------------------------------------
-- TRACKED MOVEMENT SYSTEM
--------------------------------------
local x, z = 0, 0
local dir = 0
local path = {}

local function turnRightTracked()
    turtle.turnRight(); dir = (dir + 1) % 4
end
local function turnLeftTracked()
    turtle.turnLeft(); dir = (dir + 3) % 4
end

local function forwardSafe()
    while not turtle.forward() do
        if turtle.getFuelLevel() == 0 then
            -- Out of fuel: burn tagged fuel or use the bucket. If that
            -- fails too, stop instead of retrying forever at 0 fuel.
            if not LoopFuel.ensure(cfg, minFuel) then
                error("OutOfFuel", 0)
            end
        else
            turtle.dig()
            turtle.attack()
        end
        sleep(0.05)
    end
end

local function forwardTracked()
    forwardSafe()
    if dir == 0 then z = z - 1; table.insert(path, {0,-1})
    elseif dir == 1 then x = x + 1; table.insert(path, {1,0})
    elseif dir == 2 then z = z + 1; table.insert(path, {0,1})
    elseif dir == 3 then x = x - 1; table.insert(path, {-1,0}) end
end

local function retracePath()
    while #path > 0 do
        local step = table.remove(path)
        local dx, dz = step[1], step[2]

        if dx == 1 then while dir ~= 3 do turnLeftTracked() end
        elseif dx == -1 then while dir ~= 1 do turnLeftTracked() end
        elseif dz == 1 then while dir ~= 0 do turnLeftTracked() end
        elseif dz == -1 then while dir ~= 2 do turnLeftTracked() end
        end

        forwardSafe()
        if dir == 0 then z = z - 1
        elseif dir == 1 then x = x + 1
        elseif dir == 2 then z = z + 1
        elseif dir == 3 then x = x - 1 end
    end
end

--------------------------------------
-- ITEM VACUUMING & DUMPING
--------------------------------------
local function suckAll()
    turtle.suck()
    turtle.suckDown()
end

-- The fuel/bucket slot is never dumped.
local function dumpAllDown()
    for s=1,16 do
        if s ~= cfg.bucketSlot then
            turtle.select(s)
            turtle.dropDown()
        end
    end
    turtle.select(1)
end

-- Called on every cell: dump into a chest below when found, and
-- opportunistically fill the bucket from lava below when traveling.
local function cellCheck()
    local has, data = turtle.inspectDown()
    if not has or not data or not data.name then return end
    if LoopSetup.isInventory("bottom") then
        dumpAllDown()
        LoopFuel.stage(cfg)
    elseif cfg.lavaUnder and data.name:find("lava") then
        LoopFuel.fillFrom(turtle.inspectDown, turtle.placeDown, cfg)
    end
end

--------------------------------------
-- SWEEP LOGIC
--------------------------------------
local function sweep(length, width)
    local forwardRow = true

    for row = 1, width do
        for col = 1, length do
            suckAll()
            cellCheck()

            if col < length then forwardTracked() end
        end

        if row < width then
            if forwardRow then
                turnRightTracked(); forwardTracked(); turnRightTracked()
            else
                turnLeftTracked(); forwardTracked(); turnLeftTracked()
            end
            forwardRow = not forwardRow
        end
    end
end

--------------------------------------
-- RETURN
--------------------------------------
local function returnHome(startDir)
    retracePath()
    while dir ~= startDir do turnLeftTracked() end
    x, z = 0, 0
end

--------------------------------------
-- MAIN
--------------------------------------
term.clear(); term.setCursorPos(1,1)
colorPrint("=== VACUUM SWEEPER v1.0 ===", colors.blue)

local tArgs = { ... }
local cliL, cliW = 0, 0
for i = 1, #tArgs, 2 do
    if tArgs[i] == "-length" then cliL = math.floor(tonumber(tArgs[i + 1]) or 0)
    elseif tArgs[i] == "-width" then cliW = math.floor(tonumber(tArgs[i + 1]) or 0)
    end
end
local L = cliL > 0 and cliL or readNum("Enter area LENGTH:")
local W = cliW > 0 and cliW or readNum("Enter area WIDTH:")

local scfg = LoopSetup.run({
    blurb = "Sucks up floor items in an LxW snake sweep, dumps into chests found below, returns to start each cycle.",
    fuel = true,
    fuelTags = true,
    lava = true,
    bucketSlot = 16,
})
if not scfg then
    colorPrint("Setup aborted.", colors.red)
    return
end
cfg = scfg
-- Enough fuel for a full sweep plus the trip home, capped at the limit.
minFuel = LoopFuel.capEst(2 * L * W + 10)

colorPrint("Press ENTER to start. Press Q (or Ctrl+T) to stop.", colors.green)
read()

if not LoopFuel.ensure(cfg, minFuel) then
    print("Not enough fuel to start.")
    return
end

local stop = false
local function watch()
    while true do
        local e,k = os.pullEvent()
        if e == "terminate" or (e == "key" and (k == keys.q or k == keys.enter)) then stop = true return end
    end
end

local startDir = dir

local function run()
    local ok, err = pcall(function()
        while not stop do
            path = {}
            x, z = 0,0
            dir = startDir
            sweep(L, W)
            returnHome(startDir)
            -- Back at start facing the start direction: refill the bucket
            -- from the stated lava side when possible.
            LoopFuel.fillAtStart(cfg)
        end
    end)
    if not ok then
        if err == "OutOfFuel" then
            print("Out of fuel. Stopping.")
        else
            error(err, 0)
        end
    end
end

parallel.waitForAny(run, watch)

term.clear(); term.setCursorPos(1,1)
colorPrint("Vacuum stopped. Goodbye.", colors.blue)