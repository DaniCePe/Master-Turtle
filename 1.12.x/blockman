version = 20261013.2000
-- blockman: Block Manager
-- Lists the full effective allowed block list and lets the user add or
-- remove entries. User additions persist via the CC settings API
-- (.settings); defaults are fixed and cannot be removed here.

local allowedLib = require("lib.allowedBlocks")

-- Read the user-added table, safely.
local function userExtra()
    local ok, extra = pcall(function()
        return settings.get("MasterTurtle.allowedExtra")
    end)
    if ok and type(extra) == "table" then
        return extra
    end
    return {}
end

local function sortedKeys(t)
    local keys = {}
    for k in pairs(t) do
        keys[#keys + 1] = k
    end
    table.sort(keys)
    return keys
end

local PER_PAGE = 12

-- Build the numbered effective list; numbering is global across pages.
local function buildEntries()
    local entries = {}
    for _, name in ipairs(sortedKeys(allowedLib.allowed)) do
        entries[#entries + 1] = { name = name, user = false }
    end
    for _, name in ipairs(sortedKeys(userExtra())) do
        if not allowedLib.allowed[name] then
            entries[#entries + 1] = { name = name, user = true }
        end
    end
    return entries
end

-- Print one page; return the clamped page number and page count.
local function showPage(entries, page)
    local pages = math.max(1, math.ceil(#entries / PER_PAGE))
    if page < 1 then page = 1 end
    if page > pages then page = pages end
    term.clear()
    term.setCursorPos(1, 1)
    print("Block Manager (page " .. page .. "/" .. pages .. ")")
    print("")
    if #entries == 0 then
        print("  (none)")
    else
        local from = (page - 1) * PER_PAGE + 1
        local to = math.min(#entries, page * PER_PAGE)
        for n = from, to do
            local e = entries[n]
            print(string.format("  %d. %s%s", n, e.name,
                e.user and "  [user]" or ""))
        end
    end
    print("")
    return page, pages
end

local function saveExtra(extra)
    return pcall(function()
        settings.set("MasterTurtle.allowedExtra", extra)
        settings.save()
    end)
end

local function doAdd()
    print("Full item name (e.g. minecraft:granite), or q to cancel:")
    io.write("> ")
    local raw = (read() or ""):gsub("^%s+", ""):gsub("%s+$", "")
    if raw == "" or raw:lower() == "q" then
        print("Cancelled.")
        return
    end
    local id = raw:lower()
    if allowedLib.allowed[id] then
        print(id .. " is already in the defaults.")
        return
    end
    local extra = userExtra()
    if extra[id] then
        print(id .. " is already added.")
        return
    end
    extra[id] = true
    if saveExtra(extra) then
        print("Added " .. id)
    else
        print("Could not save settings.")
    end
    print("Press Enter to continue.")
    read()
end

local function doRemove(entries)
    print("List number to remove (user-added only), or q to cancel:")
    io.write("> ")
    local raw = (read() or ""):lower()
    if raw == "q" or raw == "" then
        print("Cancelled.")
        return
    end
    local n = tonumber(raw)
    local entry = n and entries[n]
    if not entry then
        print("Not a list number.")
        return
    end
    if not entry.user then
        print("Defaults are fixed; only user-added entries can be removed.")
        return
    end
    local extra = userExtra()
    extra[entry.name] = nil
    if saveExtra(extra) then
        print("Removed " .. entry.name)
    else
        print("Could not save settings.")
    end
    print("Press Enter to continue.")
    read()
end


-- Read a choice, supporting both keyboard and mouse clicks on [n]ext/[p]rev.
-- Returns the lowercase choice string.
local function getChoice(menuRow)
    local input = ""
    term.setCursorPos(3, menuRow + 1)
    term.write("> " .. input)
    while true do
        local ev, p1, p2, p3 = os.pullEvent()
        if ev == "char" then
            input = input .. p1
            term.setCursorPos(3, menuRow + 1)
            term.write("> " .. input .. " ")
            term.setCursorPos(5 + #input, menuRow + 1)
        elseif ev == "key" then
            if p1 == keys.enter then
                print("")
                return input:lower()
            elseif p1 == keys.backspace then
                if #input > 0 then
                    input = input:sub(1, -2)
                    term.setCursorPos(3, menuRow + 1)
                    term.write("> " .. input .. " ")
                    term.setCursorPos(5 + #input, menuRow + 1)
                end
            end
        elseif ev == "mouse_click" then
            -- p2=x, p3=y. Menu: [a]dd  [r]emove  [n]ext  [p]rev  [q]uit
            -- [n]ext at x 18-23, [p]rev at x 26-31 (1-indexed).
            if p3 == menuRow then
                if p2 >= 18 and p2 <= 23 then
                    print("")
                    return "n"
                elseif p2 >= 26 and p2 <= 31 then
                    print("")
                    return "p"
                end
            end
        end
    end
end

term.clear()
term.setCursorPos(1, 1)
print("Block Manager")
print("Version: " .. version)
print("")

while true do
    local entries = buildEntries()
    local page = 1
    local done = false
    while not done do
        local pages
        page, pages = showPage(entries, page)
        print("[a]dd  [r]emove  [n]ext  [p]rev  [q]uit  (click [n]ext/[p]rev)")
        local _, menuRow = term.getCursorPos()
        menuRow = menuRow - 1 -- row of the menu line
        local choice = getChoice(menuRow)
        if choice == "q" then
            done = true
        elseif choice == "a" then
            doAdd()
            break
        elseif choice == "r" then
            doRemove(entries)
            break
        elseif choice == "n" then
            page = page + 1
            if page > pages then page = 1 end
        elseif choice == "p" then
            page = page - 1
            if page < 1 then page = pages end
        end
    end
    if done then break end
end

print("Block Manager closed.")
