--------------------------------------
-- CONSTANTS
--------------------------------------
local MAX_CARRY = 1024  -- 16 stacks × 64
local refillMode = false

--------------------------------------
-- STARTUP STATE & POSITION TRACKING
--------------------------------------
-- Assigned once dimensions are known, before the build starts.
local cfg = nil         -- LoopSetup answers (fuel chest side, lava, tags)
local tripEst = 0       -- one-way fuel estimate: block count + travel margin
local buildHeight = 0   -- wall height; restock trips fly above this level

-- Position relative to the start (after the initial turtle.up()).
local px, py, pz = 0, 0, 0
local facing = 0 -- 0:+X 1:+Y(depth) 2:-X 3:-Y
local inTrip = false -- true while flying a restock/fuel trip (no nested trips)

local checkFuel   -- proactive fuel evac; assigned with the trip machinery
local restockTrip -- return-to-start material restock; assigned with the trip machinery

--------------------------------------
-- COLORS
--------------------------------------
local function colorPrint(message, color)
    term.setTextColor(color)
    print(message)
    term.setTextColor(colors.white)
end

local function colorWrite(message, color)
    term.setTextColor(color)
    io.write(message)
    term.setTextColor(colors.white)
end

--------------------------------------
-- INPUT HANDLING
--------------------------------------
local function readNum(message)
    colorPrint(message, colors.orange)
    local n = tonumber(read())
    while not n or n <= 0 do
        colorPrint("Enter a valid positive number:", colors.red)
        n = tonumber(read())
    end
    return math.floor(n)
end

--------------------------------------
-- BLOCK COUNTING & SELECTION
--------------------------------------
local function countAllowedBlocks()
    local total = 0
    for i=1,16 do
        local detail = turtle.getItemDetail(i)
        if detail and allowedBlocks(detail.name) then
            total = total + detail.count
        end
    end
    return total
end

local function waitForBlocks(required)
    while true do
        local have = countAllowedBlocks()
        term.clear()
        term.setCursorPos(1,1)
        if have >= required then
            colorPrint("Enough allowed blocks ("..have.." / "..required..")", colors.green)
            return
        else
            colorPrint("Add allowed materials only.", colors.red)
            colorPrint("Need at least "..required.." blocks to continue.", colors.orange)
            colorPrint("Currently have: "..have, colors.orange)
            colorPrint("Press ENTER after adding blocks.", colors.orange)
            read()
        end
    end
end

local function selectAllowedBlock()
    for i=1,16 do
        local detail = turtle.getItemDetail(i)
        if detail and detail.count > 0 and allowedBlocks(detail.name) then
            turtle.select(i)
            return true
        end
    end
    return false
end

local function placeDownSmart()
    local exists, data = turtle.inspectDown()
    if exists then
        if not allowedBlocks(data.name) then
            turtle.digDown()
        else
            return
        end
    end

    while not selectAllowedBlock() do
        restockTrip()
    end
    turtle.placeDown()
end

--------------------------------------
-- SAFE MOVEMENT
--------------------------------------
local function forwardSafe()
    checkFuel() -- evacuate home for fuel before getting stranded
    while not turtle.forward() do
        turtle.dig()
        turtle.attack()
        sleep(0.1)
    end
    if facing == 0 then px = px + 1
    elseif facing == 1 then py = py + 1
    elseif facing == 2 then px = px - 1
    else py = py - 1 end
end

local function upSafe()
    checkFuel()
    while not turtle.up() do
        turtle.digUp()
        sleep(0.1)
    end
    pz = pz + 1
end

local function downSafe()
    while not turtle.down() do
        turtle.digDown()
        sleep(0.1)
    end
    pz = pz - 1
end

local function turnRight()
    turtle.turnRight()
    facing = (facing + 1) % 4
end
local function turnLeft()
    turtle.turnLeft()
    facing = (facing + 3) % 4
end

--------------------------------------
-- RESTOCK & FUEL TRIPS
--------------------------------------
-- The turtle flies above the finished layers (buildHeight) back to the
-- start column, refills, then resumes the saved build position. It never
-- waits for materials stranded mid-build.

local function turnToFace(f)
    local diff = (f - facing) % 4
    if diff == 1 then turnRight()
    elseif diff == 2 then turnRight(); turnRight()
    elseif diff == 3 then turnLeft() end
end

local function flyTo(tx, ty)
    if px < tx then
        turnToFace(0)
        while px < tx do forwardSafe() end
    elseif px > tx then
        turnToFace(2)
        while px > tx do forwardSafe() end
    end
    if py < ty then
        turnToFace(1)
        while py < ty do forwardSafe() end
    elseif py > ty then
        turnToFace(3)
        while py > ty do forwardSafe() end
    end
end

local function goHome()
    while pz < buildHeight do upSafe() end -- above the finished layers
    flyTo(0, 0)
end

local function resumePos(sx, sy, sz, sf)
    flyTo(sx, sy)
    while pz > sz do downSafe() end -- the column above the build is clear air
    turnToFace(sf)
end

local function suckMaterials()
    -- Pull build materials from adjacent chests (front/up/down).
    -- Slots 1-15 only; 16 is the fuel/bucket slot.
    local pick = 1
    for i = 1, 15 do
        if turtle.getItemCount(i) < 64 then pick = i break end
    end
    turtle.select(pick)
    for _, fn in ipairs({ "suck", "suckUp", "suckDown" }) do
        while turtle[fn]() do end
    end
    turtle.select(1)
end

local function waitForRestock(seconds)
    -- Wait at the start block (reachable) for blocks to appear.
    -- Yields in 1s steps and keeps sucking; false only if Q is pressed.
    local elapsed = 0
    while elapsed < seconds do
        if countAllowedBlocks() > 0 then return true end
        suckMaterials()
        local timer = os.startTimer(1)
        while true do
            local ev, p1 = os.pullEvent()
            if ev == "timer" and p1 == timer then break end
            if ev == "key" and p1 == keys.q then return false end
            if ev == "terminate" then error("Terminated", 0) end
        end
        elapsed = elapsed + 1
    end
    return true
end

local function topUpFuel()
    -- Fixed-point refuel at the start. If the point is dry, wait for fuel
    -- items here (reachable); Q aborts and the program stops quietly.
    if not LoopFuel.refuelAtStart(cfg, 2 * tripEst) then
        if not LoopFuel.waitForFuel(cfg, 2 * tripEst) then
            error("", 0)
        end
    end
end

local function fuelTrip()
    -- Proactive fuel evac: head home while the trip is still affordable.
    inTrip = true
    local sx, sy, sz, sf = px, py, pz, facing
    goHome()
    topUpFuel()
    resumePos(sx, sy, sz, sf)
    inTrip = false
end

restockTrip = function()
    inTrip = true
    local sx, sy, sz, sf = px, py, pz, facing
    colorPrint("Out of allowed blocks! Returning to start for restock.", colors.red)
    goHome()
    suckMaterials()
    topUpFuel()
    if not waitForRestock(30) then
        error("", 0) -- Q pressed; stop quietly
    end
    resumePos(sx, sy, sz, sf)
    inTrip = false
    colorPrint("Resuming build.", colors.green)
end

checkFuel = function()
    if inTrip or not cfg then return end
    if LoopFuel.needEvac(math.abs(px) + math.abs(py) + math.abs(pz)) then
        fuelTrip()
    end
end

--------------------------------------
-- SESSION MATERIAL OFFER (plan item 8B)
--------------------------------------
local function offerSessionMaterials()
    -- Offer the distinct block types already in inventory (slots 1-15;
    -- 16 is the fuel/bucket slot) as this run's material list.
    -- Session-only; nothing is stored.
    local seen, names = {}, {}
    for i = 1, 15 do
        local d = turtle.getItemDetail(i)
        if d and d.name and not d.name:lower():find("bucket", 1, true) then
            local n = d.name:lower()
            if not seen[n] then
                seen[n] = true
                names[#names + 1] = d.name
            end
        end
    end
    if #names == 0 then return end
    colorPrint("Block types in inventory:", colors.orange)
    for _, n in ipairs(names) do print("  " .. n) end
    io.write("Use these block types as build material for this run? [Y/n] ")
    local ans = (read() or ""):lower()
    if ans == "" or ans == "y" or ans == "yes" then
        local set = {}
        for n in pairs(seen) do set[n] = true end
        if allowedLib.setSession then allowedLib.setSession(set) end
        colorPrint("Session material list set (" .. #names .. " types).", colors.green)
    end
end

--------------------------------------
-- UI FUNCTIONS
--------------------------------------
local function drawUI(placed, total)
    term.clear()
    term.setCursorPos(1,1)
    colorPrint("=== TRMP Wall Builder v0.4 ===", colors.blue)
    print(string.rep("=",30))

    colorWrite("Blocks placed: ", colors.green)
    colorPrint(placed.." / "..total, colors.orange)

    -- Progress bar
    local percent = math.floor((placed/total)*100)
    io.write("Progress: [")
    local bars = math.floor(percent/5)
    for i=1,20 do
        if i <= bars then
            colorWrite("=", colors.blue)
        else
            io.write(" ")
        end
    end
    colorPrint("] "..percent.."%", colors.orange)

    -- Fuel
    local fuel = turtle.getFuelLevel()
    local fuelMax = turtle.getFuelLimit()
    colorWrite("Fuel: ", colors.green)
    colorPrint(fuel.." / "..fuelMax, colors.orange)

    print(string.rep("=",30))
end

--------------------------------------
-- MAIN PROGRAM
--------------------------------------
term.clear()
term.setCursorPos(1,1)
colorPrint("=== TRMP Wall Builder v0.4 ===", colors.blue)

local tArgs = { ... }
local cliL, cliH, cliD = 0, 0, 0
for i = 1, #tArgs, 2 do
    if tArgs[i] == "-length" then cliL = math.floor(tonumber(tArgs[i + 1]) or 0)
    elseif tArgs[i] == "-height" then cliH = math.floor(tonumber(tArgs[i + 1]) or 0)
    elseif tArgs[i] == "-depth" then cliD = math.floor(tonumber(tArgs[i + 1]) or 0)
    end
end
local length = cliL > 0 and cliL or readNum("Enter wall length (X-axis):")
local height = cliH > 0 and cliH or readNum("Enter wall height (Z-axis):")
local depth  = cliD > 0 and cliD or readNum("Enter wall thickness (Y-axis):")
buildHeight = height

-- Block estimate: length * height * depth.
local totalBlocks = length * height * depth
colorPrint("Total required blocks: "..totalBlocks, colors.orange)

-- One-way fuel estimate: the block count plus a small travel margin.
-- Kept far above needEvac's dist+10 so a fuel trip never re-triggers.
tripEst = totalBlocks + 64

-- Warn if exceeds MAX_CARRY
if totalBlocks > MAX_CARRY then
    colorPrint("WARNING: Wall requires more blocks than the turtle can carry!", colors.red)
    colorPrint("Max carry: "..MAX_CARRY.." (16 stacks)", colors.red)
    colorPrint("Total required blocks: "..totalBlocks, colors.orange)
    colorPrint("A refill will be required during construction.", colors.red)
    colorPrint("Continue? (y/n)", colors.orange)
    while true do
        local ans = read()
        if ans == "y" or ans == "Y" then
            refillMode = true
            break
        elseif ans == "n" or ans == "N" then
            colorPrint("Restarting input...", colors.red)
            sleep(0.5)
            os.reboot()
        else
            colorPrint("Enter Y or N:", colors.red)
        end
    end
elseif totalBlocks > 960 then
    -- Over 960 blocks (15 stacks) the turtle cannot carry it all, so a
    -- mid-run restock will be needed. It returns to the start block for
    -- refills on its own; no action needed now.
    colorPrint("WARNING: This job needs "..totalBlocks.." blocks, over 960 (15 stacks).", colors.red)
    colorPrint("A mid-run restock will be needed; the turtle returns to the start block for it.", colors.orange)
end

-- Fuel setup: every question answered once, here.
cfg = LoopSetup.run({
    blurb = "TRMP wall builder: builds a length x height x depth wall, placing downward. "
        .. "Mid-run it returns to the start block for material and fuel refills.",
    fuel = true, fuelTags = true, lava = true, fuelChest = true, bucketSlot = 16,
})
if not cfg then
    colorPrint("Setup aborted.", colors.orange)
    return
end
if not LoopFuel.ensure(cfg, tripEst) then
    return -- user aborted the fuel wait; stop quietly
end

colorPrint("Press ENTER when blocks are loaded.", colors.green)
read()

-- Wait for starting blocks
local needed = refillMode and 64 or totalBlocks
waitForBlocks(needed)

-- Session material offer (plan item 8B), after blocks are loaded and
-- before any digging.
offerSessionMaterials()

-- Countdown 5 seconds
for i=5,1,-1 do
    term.clear()
    term.setCursorPos(1,1)
    colorPrint("Starting wall construction in: "..i.."...", colors.green)
    sleep(1)
end
upSafe() -- replaces the old bare turtle.up(); tracks the start height
term.clear()
term.setCursorPos(1,1)

--------------------------------------
-- BUILD LOOP
--------------------------------------
local placed = 0
local goingForward = true

for z=1,height do          -- vertical layers
    for y=1,depth do       -- thickness
        for x=1,length do  -- row
            placeDownSmart()
            placed = placed + 1
            drawUI(placed, totalBlocks)

            if x < length then
                forwardSafe()
            end
        end

        -- Snake pattern in depth
        if y < depth then
            if goingForward then
                turnRight()
                forwardSafe()
                turnRight()
            else
                turnLeft()
                forwardSafe()
                turnLeft()
            end
            goingForward = not goingForward
        end
    end

    -- Move up a layer
    if z < height then
        upSafe()
        -- Reset Y facing
        if depth % 2 == 1 then
            turnRight(); turnRight()
        end
        goingForward = true
    end
end

drawUI(totalBlocks, totalBlocks)
colorPrint("Wall completed successfully!", colors.green)