version = 20261012.1200
-- FRAME BUILDER v0.1
	-- Builds either:
		-- A) A hollow ROOM (full shell)
		-- B) A FRAME (edges only)
	-- Inspired by PLATFORM BUILDER + TRMP

--------------------------------------
-- CONSTANTS
--------------------------------------
local MAX_CARRY = 1024
local refillMode = false

--------------------------------------
-- COLORS
--------------------------------------
local function colorPrint(msg, color)
    term.setTextColor(color)
    print(msg)
    term.setTextColor(colors.white)
end

local function colorWrite(msg, color)
    term.setTextColor(color)
    io.write(msg)
    term.setTextColor(colors.white)
end

--------------------------------------
-- BLOCK RULES
--------------------------------------
local function isAllowed(name)
    if allowedBlocks(name) then return true end

    local n = string.lower(name)
    if n:find("bars") then return true end
    if n:find("_wall$") then return true end
    if n:find("_fence$") then return true end
    if n:find("fence_") then return true end

    return false
end

--------------------------------------
-- INPUT
--------------------------------------
local function readNum(msg)
    colorPrint(msg, colors.orange)
    local n = tonumber(read())
    while not n or n <= 0 do
        colorPrint("Enter a valid positive number:", colors.red)
        n = tonumber(read())
    end
    return math.floor(n)
end
--------------------------------------
-- BLOCK COUNTING
--------------------------------------
local function countAllowed()
    local t = 0
    for i=1,16 do
        local d = turtle.getItemDetail(i)
        if d and isAllowed(d.name) then t = t + d.count end
    end
    return t
end

local function waitForBlocks(required)
    while true do
        local have = countAllowed()
        term.clear(); term.setCursorPos(1,1)

        if have >= required then
            colorPrint("Enough allowed blocks ("..have.." / "..required..")", colors.green)
            return
        end

        colorPrint("Add allowed materials ONLY!", colors.red)
        colorPrint("Need at least "..required.." blocks.", colors.orange)
        colorPrint("Currently have: "..have, colors.orange)
        print("")
        colorPrint("Press ENTER after adding blocks.", colors.orange)
        read()
    end
end

--------------------------------------
-- BLOCK SELECTION & PLACEMENT
--------------------------------------
local function selectAllowed()
    for i=1,16 do
        local d = turtle.getItemDetail(i)
        if d and d.count > 0 and isAllowed(d.name) then
            turtle.select(i)
            return true
        end
    end
    return false
end

local function placeDownSmart()
    local ok,data = turtle.inspectDown()
    if ok and not isAllowed(data.name) then turtle.digDown() end

    while not selectAllowed() do
        colorPrint("OUT OF ALLOWED BLOCKS! Add more & press ENTER.", colors.red)
        read()
    end

    turtle.placeDown()
end

--------------------------------------
-- SAFE MOVEMENT
--------------------------------------
local function forwardSafe()
    while not turtle.forward() do
        turtle.dig(); turtle.attack(); sleep(0.1)
    end
end

local function upSafe()
    while not turtle.up() do
        turtle.digUp(); sleep(0.1)
    end
end

local function downSafe()
    while not turtle.down() do
        turtle.digDown(); sleep(0.1)
    end
end

--------------------------------------
-- UI
--------------------------------------
local function drawUI(placed,total)
    term.clear(); term.setCursorPos(1,1)
    colorPrint("=== HOLLOW CUBE BUILDER v1.0 ===", colors.blue)
    print(string.rep("=",30))

    colorWrite("Blocks placed: ", colors.green)
    colorPrint(placed.." / "..total, colors.orange)

    local percent = math.floor((placed/total)*100)
    io.write("Progress: [")
    local bars = math.floor(percent/5)
    for i=1,20 do
        if i <= bars then colorWrite("=", colors.blue) else io.write(" ") end
    end
    colorPrint("] "..percent.."%", colors.orange)

    colorWrite("Fuel: ", colors.green)
    colorPrint(turtle.getFuelLevel().." / "..turtle.getFuelLimit(), colors.orange)

    print(string.rep("=",30))
end

--------------------------------------
-- SHAPE BUILDERS
--------------------------------------
local function buildFrame(size, placed, total)
    -- Builds the cube edges only
    for layer=1,size do
        -- 4 edges around
        for i=1,4 do
            for s=1,size-1 do
                placeDownSmart(); placed=placed+1; drawUI(placed,total)
                if s < size-1 then forwardSafe() end
            end
            turtle.turnRight()
        end
        if layer < size then
            upSafe()
        end
    end
    return placed
end

local function buildShell(size, placed, total)
    -- full hollow room
    for h=1,size do
        for side=1,4 do
            for s=1,size do
                placeDownSmart(); placed=placed+1; drawUI(placed,total)
                if s < size then forwardSafe() end
            end
            turtle.turnRight()
        end
        if h < size then upSafe() end
    end
    return placed
end

--------------------------------------
-- MAIN
--------------------------------------
term.clear(); term.setCursorPos(1,1)
colorPrint("=== HOLLOW CUBE BUILDER v1.0 ===", colors.blue)

-- Mode selection
colorPrint("Choose mode:", colors.orange)
colorPrint("A) Hollow ROOM (full shell)", colors.green)
colorPrint("B) FRAME (edges only)", colors.green)

local mode
while true do
    local m = string.lower(read())
    if m == "a" then mode="shell" break end
    if m == "b" then mode="frame" break end
    colorPrint("Enter A or B", colors.red)
end

local tArgs = { ... }
local cliSize = 0
for i = 1, #tArgs, 2 do
    if tArgs[i] == "-size" then cliSize = math.floor(tonumber(tArgs[i + 1]) or 0) end
end
local size = cliSize > 0 and cliSize or readNum("Enter cube size (N x N x N):")

-- block requirement estimate
local required
if mode=="frame" then
    required = (size * 4) * size
else
    required = (size * size * 4) * size
end

colorPrint("Minimum required blocks: "..required, colors.orange)
colorPrint("Press ENTER when materials are loaded.", colors.green)
read()

-- Allow starting with 64 blocks (or required if <64)
local minStart = math.min(64, required)
waitForBlocks(minStart)

-- countdown
for i=5,1,-1 do
    term.clear(); term.setCursorPos(1,1)
    colorPrint("Starting in: "..i, colors.green)
    sleep(1)
end

local placed = 0

-- elevate to build bottom layer under
upSafe()

if mode=="frame" then
    placed = buildFrame(size, placed, required)
else
    placed = buildShell(size, placed, required)
end

drawUI(required, required)
colorPrint("Hollow cube completed successfully!", colors.green)